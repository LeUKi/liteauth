{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "liteauth-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:5188",
    "ENVIRONMENT": "development",
    "ADMIN_LINUXDO_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liteauth-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8798
  }
}
