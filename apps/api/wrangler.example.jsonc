{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "liteauth-api-local",
  "main": "src/index.ts",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:5188",
    "ENVIRONMENT": "development",
    "ADMIN_LINUXDO_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "liteauth-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "liteauth-staging-api",
      "vars": {
        "APP_ORIGIN": "https://staging.liteauth.example.com",
        "ENVIRONMENT": "staging",
        "ADMIN_LINUXDO_ID": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "liteauth-staging",
          "database_id": "YOUR_STAGING_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "routes": [
        {
          "pattern": "staging.liteauth.example.com/api/*",
          "zone_name": "example.com"
        },
        {
          "pattern": "staging.liteauth.example.com/auth/*",
          "zone_name": "example.com"
        },
        {
          "pattern": "staging.liteauth.example.com/oauth2/*",
          "zone_name": "example.com"
        },
        {
          "pattern": "staging.liteauth.example.com/.well-known/*",
          "zone_name": "example.com"
        }
      ],
      "triggers": {
        "crons": [
          "17 * * * *",
          "30 20 * * *"
        ]
      }
    },
    "production": {
      "name": "liteauth-production-api",
      "vars": {
        "APP_ORIGIN": "https://liteauth.example.com",
        "ENVIRONMENT": "production",
        "ADMIN_LINUXDO_ID": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "liteauth-production",
          "database_id": "YOUR_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],
      "routes": [
        {
          "pattern": "liteauth.example.com/api/*",
          "zone_name": "example.com"
        },
        {
          "pattern": "liteauth.example.com/auth/*",
          "zone_name": "example.com"
        },
        {
          "pattern": "liteauth.example.com/oauth2/*",
          "zone_name": "example.com"
        },
        {
          "pattern": "liteauth.example.com/.well-known/*",
          "zone_name": "example.com"
        }
      ],
      "triggers": {
        "crons": [
          "17 * * * *",
          "30 20 * * *"
        ]
      }
    }
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8798
  }
}
