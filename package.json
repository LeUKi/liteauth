{
  "name": "liteauth",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test && pnpm test:deployment",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @liteauth/api db:generate",
    "db:migrate:local": "pnpm --filter @liteauth/api db:migrate:local",
    "deploy:check": "node scripts/deploy.mjs --check",
    "deploy:staging": "node scripts/deploy.mjs --env staging",
    "deploy:production": "node scripts/deploy.mjs --env production",
    "test:deployment": "node --test scripts/deploy.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "eslint": "^10.12.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "wrangler": "4.147.0"
  },
  "license": "MIT",
  "author": "lafish",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeUKi/liteauth.git"
  }
}
